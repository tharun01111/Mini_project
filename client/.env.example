# ─────────────────────────────────────────────────────────────────────────────
# SympoHub Client — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env or .env.local for local overrides.
# In Vite, only variables prefixed with VITE_ are exposed to the client bundle
# via `import.meta.env.VITE_*`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ──────────────────────────────────────────────────────────
# The base URL of your backend REST API.
#
# LOCAL DEVELOPMENT:
#   Use "/api" to take advantage of Vite's dev proxy (configured in vite.config.js),
#   which transparently proxies requests to http://localhost:5000.
#   Alternatively: "http://localhost:5000/api"
#
# PRODUCTION (Render / Vercel / Netlify):
#   Set this to your live Render backend URL, for example:
#   "https://symposium-server.onrender.com/api"
#   (Note: The client auto-normalizes and appends /api if you omit it)
#
VITE_API_BASE_URL="http://localhost:5000/api"

# ── Vite Dev Proxy Target ───────────────────────────────────────────────────
# Used by vite.config.js during local development (`npm run dev`).
# Change this if your backend runs on a different port or host.
VITE_DEV_BACKEND_TARGET="http://localhost:5000"

# ── Application Branding & Metadata ──────────────────────────────────────────
VITE_APP_TITLE="SympoHub — Unified Symposium Platform"
VITE_APP_DESCRIPTION="Centralized college symposium, technical festival, ticketing and certificate management platform."
VITE_SUPPORT_EMAIL="support@sympohub.edu"

# ── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to enable simulated test payment gateways (UPI, NetBanking, Card)
# without requiring live payment gateway credentials.
VITE_ENABLE_MOCK_PAYMENTS="true"

# QR Ticket Scanner Frame Rate (frames per second)
VITE_QR_SCANNER_FPS="10"

