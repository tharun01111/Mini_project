# ─────────────────────────────────────────────────────────────────────────────
# Symposium Platform — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Port the HTTP server listens on. Render injects PORT automatically.
PORT=5000

# Set to "production" on Render. Controls logging verbosity, error detail, etc.
NODE_ENV=production

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
#
# CONNECTION STRATEGY (Supabase):
#   DATABASE_URL  → Transaction Pooler (Supavisor, port 6543)
#                   Used at RUNTIME for all application queries.
#                   Append ?pgbouncer=true to the URL (Supabase provides this).
#
#   DIRECT_URL    → Direct connection (port 5432, no pooler)
#                   Used ONLY by `prisma migrate deploy`.
#                   Required for migration commands because PgBouncer transaction
#                   mode does not support the multi-statement DDL that migrations emit.
#
# WHY TRANSACTION POOLER?
#   Render's free/starter tier uses shared IPs and does NOT support IPv4 direct
#   connections to Supabase without the IPv4 add-on. The Supavisor transaction
#   pooler endpoint resolves over IPv4 and is the recommended connection method
#   for stateless serverless/PaaS environments.
#
# Get both URLs from: Supabase Dashboard → Project → Settings → Database → Connection string
# Select "Transaction pooler" for DATABASE_URL and "Direct connection" for DIRECT_URL.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Authentication ────────────────────────────────────────────────────────────
# Strong, random secret for signing JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be at least 32 characters. Keep it secret — never log or expose it.
JWT_SECRET="replace-with-a-cryptographically-random-64-char-hex-string"

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# The deployed frontend URL. The backend rejects cross-origin requests from
# any origin not listed here. Comma-separate multiple origins if needed.
# Example: "https://symposium-client.onrender.com"
CLIENT_URL="http://localhost:3000"

# ── Optional Tuning ───────────────────────────────────────────────────────────
# Maximum pg connections per application instance (default: 10).
# Keep low to avoid exhausting Supabase Supavisor limits.
# DB_POOL_MAX=10
